# Binaries / build output
*.exe
*.dll
*.so
*.dylib
build/
bin/
backup/
desktop/build/
# Исключение: исходник и иконка приложения — в git идут (собираются в exe);
# остальное содержимое desktop/build/ (bin/ и прочее) — нет.
# (Папку целиком игнорить нельзя — тогда исключения файлов не сработают,
# это касается и общего правила build/ выше.)
!desktop/build/
desktop/build/*
!desktop/build/appicon.png
!desktop/build/windows/
desktop/build/windows/*
!desktop/build/windows/icon.ico
/release/

# Wails / frontend (dist и package.json.md5 — артефакты `wails build`, в git не идут;
# package-lock.json — коммитим. Каноническая сборка десктопа — `wails build`,
# он сам ставит npm-зависимости и строит frontend перед go build.)
desktop/frontend/node_modules/
desktop/frontend/dist/
desktop/frontend/.svelte-kit/
desktop/frontend/package.json.md5
node_modules/
node_modules/

# Go
*.test
*.out
coverage.txt

# SQLite / app data (never commit real DB)
*.db
*.db-*
*.sqlite
*.sqlite-*
app.db

# Legacy seeds (local only, never commit; runtime starts clean).
# Tests use trimmed fixtures in testdata/.
/xlsx/
/csv/

# Backups / exports with real data
*.zip
backup*.zip

# OS / editors
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo
~$*

# Secrets / env
.env
.env.*
*.key
*.pem
secrets/
desktop/frontend/wailsjs/

# Harness session transcripts
session-*.md
